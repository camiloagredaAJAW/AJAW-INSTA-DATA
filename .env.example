NODE_ENV=development
PORT=3000

APP_BASE_URL=https://middleware.example.com
AXELOR_BASE_URL=https://data.ajawmrp.com
AXELOR_LOGIN_PATH=/login.jsp
AXELOR_USERNAME=<axelor-username>
AXELOR_PASSWORD=<axelor-password>
AJAW_NAMESPACE=com.ajawmrp3.apps.prospectingai.db
MODEL_NAME_AGENT=Agent
MODEL_NAME_INSTAGRAM_ACCOUNT=InstagramAccount

CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_MAIN_ACCOUNT_ID=
CHATWOOT_MAIN_API_ACCESS_TOKEN=

META_APP_ID=<meta-app-id>
META_APP_SECRET=<meta-app-secret>
META_WEBHOOK_VERIFY_TOKEN=<meta-webhook-verify-token>
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_OAUTH_REDIRECT_URI=https://middleware.example.com/integrations/instagram/webhook
INSTAGRAM_ENABLE_LONG_LIVED_TOKEN_EXCHANGE=false

INTERNAL_API_KEY=<internal-api-key>
LOG_LEVEL=info
